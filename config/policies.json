{
  "corsPolicies": [
    {
      "name": "anything",
      "allowedOrigins": [
        "*"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS",
        "HEAD",
        "PATCH"
      ],
      "allowedHeaders": [
        "*"
      ],
      "allowCredentials": false,
      "maxAge": 86400
    }
  ],
  "policies": [
    {
      "handler": {
        "export": "AIGatewayAuthV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {}
      },
      "name": "ai-gateway-auth-v2-inbound",
      "policyType": "ai-gateway-auth-v2"
    },
    {
      "handler": {
        "export": "AIGatewayConfigurationLoaderV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "cacheTtlSeconds": 5
        }
      },
      "name": "ai-gateway-configuration-loader-v2-inbound",
      "policyType": "ai-gateway-configuration-loader-v2"
    },
    {
      "handler": {
        "export": "AIGatewayConfigurationExecutorV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {}
      },
      "name": "ai-gateway-configuration-executor-v2-inbound",
      "policyType": "ai-gateway-configuration-executor-v2"
    },
    {
      "handler": {
        "export": "AIGatewayMeteringV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {}
      },
      "name": "ai-gateway-metering-v2-inbound",
      "policyType": "ai-gateway-metering-v2"
    },
    {
      "handler": {
        "export": "AIGatewayModelFilteringV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "models": {
            "completions": {
              "allowList": [
                "openai/gpt-4o-mini",
                "@cf/google/gemma-4-26b-a4b-it",
                "@cf/meta/llama-3.3-70b-instruct",
                "@cf/meta/llama-3-8b-instruct",
                "@cf/qwen/qwen2.5-72b-instruct"
              ]
            }
          }
        }
      },
      "name": "ai-gateway-model-filtering-v2-inbound",
      "policyType": "ai-gateway-model-filtering-v2"
    },
    {
      "handler": {
        "export": "AIGatewayFallbackModelV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "models": {
            "completions": {
              "fallback": "@cf/google/gemma-4-26b-a4b-it"
            }
          },
          "fallbackTimeoutSeconds": 60
        }
      },
      "name": "ai-gateway-fallback-model-v2-inbound",
      "policyType": "ai-gateway-fallback-model-v2"
    },
    {
      "handler": {
        "export": "AIGatewaySemanticCacheV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "semanticTolerance": 0.4,
          "expirationSecondsTtl": 3600
        }
      },
      "name": "ai-gateway-semantic-cache-v2-inbound",
      "policyType": "ai-gateway-semantic-cache-v2-inbound"
    },
    {
      "handler": {
        "export": "AkamaiAIFirewallV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "configurationId": "",
          "api-key": ""
        }
      },
      "name": "akamai-ai-firewall-v2-inbound",
      "policyType": "akamai-ai-firewall-v2-inbound"
    },
    {
      "handler": {
        "export": "CometOpikTracingV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "apiKey": "",
          "projectName": "",
          "workspace": ""
        }
      },
      "name": "comet-opik-tracing-v2-inbound",
      "policyType": "comet-opik-tracing-v2-inbound"
    },
    {
      "handler": {
        "export": "GalileoTracingV2InboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "apiKey": "",
          "projectId": "",
          "logStreamId": ""
        }
      },
      "name": "galileo-tracing-v2-inbound",
      "policyType": "galileo-tracing-v2-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/smart-dlp)",
        "options": {
          "rules": {
            "inbound": {
              "pii": {
                "action": "mask"
              },
              "secret": {
                "action": "block"
              },
              "finance-credit-card": {
                "action": "mask"
              },
              "finance-iban": {
                "action": "mask"
              }
            },
            "outbound": {
              "pii": {
                "action": "mask"
              },
              "secret": {
                "action": "block"
              },
              "finance-credit-card": {
                "action": "mask"
              },
              "finance-iban": {
                "action": "mask"
              }
            }
          }
        }
      },
      "name": "smart-dlp",
      "policyType": "custom-code-inbound"
    },
    {
      "name": "round-robin-embeddings",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/round-robin-embeddings)",
        "options": {
          "providers": [
            "jinaai",
            "jinaai02"
          ],
          "targetModel": "jina-embeddings-v5-text-small",
          "strategy": "round-robin",
          "enableFallback": true,
          "fallbackTimeoutSeconds": 5,
          "enableCircuitBreaker": true,
          "cooldownMinutes": 15
        }
      }
    },
    {
      "name": "round-robin-embeddings-outbound",
      "policyType": "custom-code-outbound",
      "handler": {
        "export": "outboundHandler",
        "module": "$import(./modules/round-robin-embeddings)",
        "options": {
          "cooldownMinutes": 15
        }
      }
    },
    {
      "name": "round-robin-cloudflare",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/round-robin-cloudflare)",
        "options": {
          "providers": [
            "cloudflare",
            "cloudflare-2",
            "cloudflare-3"
          ],
          "targetModel": "@cf/google/gemma-4-26b-a4b-it",
          "capability": "completions",
          "strategy": "round-robin",
          "enableFallback": true,
          "fallbackTimeoutSeconds": 5,
          "enableCircuitBreaker": true,
          "cooldownMinutes": 15
        }
      }
    },
    {
      "name": "round-robin-cloudflare-outbound",
      "policyType": "custom-code-outbound",
      "handler": {
        "export": "outboundHandler",
        "module": "$import(./modules/round-robin-cloudflare)",
        "options": {
          "cooldownMinutes": 15
        }
      }
    }
  ]
}
